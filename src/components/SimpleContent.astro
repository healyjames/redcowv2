---
interface Props {
  heading?: string;
  headingLevel?: 'h1' | 'h2' | 'h3' | 'h4' | 'h5' | 'h6';
  headingSize?: 'h3';
  text?: string | string[];
  cta?: {
    text: string;
    href: string;
  };
  className?: string;
}

const {
  heading,
  headingLevel = 'h2',
  headingSize,
  text,
  cta,
  className = 'simple-content'
} = Astro.props;

const HeadingTag = headingLevel;
const paragraphs = Array.isArray(text) ? text : [text];
---

<style>
  .heading-size-h3 {
    font-size: 1.875rem;
    line-height: 2.5rem;
    font-weight: 600;
  }
</style>

<section class={className}>
  <div class="section-inner">
    <div>
      {heading && 
        (<HeadingTag class={headingSize && `heading-size-${headingSize}`}>{heading}</HeadingTag>) }
        {paragraphs.map(paragraph => (
          <p set:html={paragraph} />
        ))}
      {cta && (
        <div class="cta-container">
          <a class="btn btn-primary" href={cta.href}>
            {cta.text}
          </a>
        </div>
      )}
    </div>
  </div>
</section>
