# Build-time configuration. Copy to `.env`.
#
# These are the only values that belong here. Runtime values
# (EMAIL_FROM, EMAIL_ADMIN, ALLOWED_ORIGINS) live in each brand's
# src/assets/<brand>/wrangler.jsonc, overridden locally by
# src/assets/<brand>/.dev.vars — see .dev.vars.example.

# Which brand to build. Must match a folder in src/assets/.
# Required: `npm run setup` exits if this is unset.
PUBLIC_BRAND=redcow

# Used for the sitemap and canonical URLs.
PUBLIC_SITE_URL=http://localhost:4321/
